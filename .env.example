# ============================================================
# AI Film Studio — environment configuration (safe placeholders)
# Copy to .env and fill in. NEVER commit the real .env file.
# The backend is the only process that reads these values.
# ============================================================

# --- BytePlus ModelArk (Seedance) ---------------------------
# API key from the BytePlus console (ModelArk > API key management).
ARK_API_KEY=
# Asia Pacific (ap-southeast) region endpoint — verified default.
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# Model ID from the model registry, e.g. dreamina-seedance-2-0-mini-260615.
# Leave empty in mock mode. Do not copy model IDs from blog posts.
ARK_MODEL_ID=

# --- Provider behaviour --------------------------------------
# Seconds between task status polls.
ARK_POLL_INTERVAL_SECONDS=5
# Timeout per provider HTTP request.
ARK_REQUEST_TIMEOUT_SECONDS=30

# Set true to run fully without credentials or paid calls (explicit mock mode).
USE_MOCK_PROVIDER=true

# --- Application storage (safe defaults; paths must be local) -
# Root for the SQLite database and app-managed media (generated videos).
STORAGE_ROOT=./data
# Root for film project folders (bible, references, scenes).
PROJECTS_ROOT=./projects

# --- Server ---------------------------------------------------
# Bind host. Keep 127.0.0.1 — do not expose the backend publicly.
API_HOST=127.0.0.1
API_PORT=8000
# The ONLY origin allowed by CORS (frontend dev server).
FRONTEND_ORIGIN=http://localhost:3210

# --- Upload limits --------------------------------------------
MAX_UPLOAD_SIZE_MB=30

# --- Budget policy (application-side spending controls) ------
# Agents must never raise these. Changes require explicit user approval.
BUDGET_LIMIT_24H_USD=7.0
BUDGET_LIMIT_7D_USD=50.0
# Extra safety margin applied to cost estimates when reserving budget.
BUDGET_SAFETY_MARGIN=0.10
# Per-operation threshold above which explicit user approval is required.
BUDGET_APPROVAL_THRESHOLD_USD=2.0
